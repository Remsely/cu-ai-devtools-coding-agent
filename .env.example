# Пример настройки окружения. Скопируйте в .env (в .gitignore) и заполните.

# Любой OpenAI-compatible Chat Completions API.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=sk-замените-на-свой-ключ
OPENAI_MODEL=gpt-4o-mini

# Проверено локально: Ollama + qwen3.5:9b (RTX 4070 Ti, ~6 ГБ в 4-bit)
# OPENAI_BASE_URL=http://localhost:11434/v1/
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3.5:9b
# AGENT_LLM_EXTRA={"think": false, "temperature": 0.2}
#
# ВАЖНО для Ollama: сервер по умолчанию режет контекст до 4096 токенов
# (num_ctx) БЕЗ предупреждения — на длинных диалогах агента это проявляется
# пустыми ответами модели. Поднимите лимит перед запуском сервера:
#   setx OLLAMA_CONTEXT_LENGTH 65536      (Windows, затем перезапустить Ollama)
#   export OLLAMA_CONTEXT_LENGTH=65536    (Linux/macOS)
# 65536 — разумный максимум для 12 ГБ VRAM: все слои модели остаются на GPU.

# Доп. поля запроса к API (JSON), например отключение рассуждений qwen3.x:
# AGENT_LLM_EXTRA={"think": false}

# Каталог проекта, с которым работает агент (по умолчанию — ./workspace;
# можно переопределить флагом --workspace):
# AGENT_WORKSPACE=C:/path/to/some/project

# Необязательно:
# AGENT_BASH_TIMEOUT=60        # лимит времени Bash-команд, секунды
